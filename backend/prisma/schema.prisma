generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//
// UTILISATEURS
//

model User {
  id           String     @id @default(uuid())
  token        String     @unique
  avatarUrl    String?
  name         String?
  status       UserStatus @default(OFFLINE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Amis
  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")

  invitesSent    GameInvite[]        @relation("InviteSender")
  invitesReceived GameInvite[]       @relation("InviteReceiver")

  // Scores et succès
  leaderboardScores LeaderboardScore[]
  achievements      UserAchievement[]

  @@index([status])
}

enum UserStatus {
  ONLINE
  IN_GAME
  AWAY
  OFFLINE
}

//
// AMIS
//

model Friendship {
  id String @id @default(uuid())

  requesterId String
  requester   User   @relation("FriendshipRequester",fields: [requesterId],references: [id],onDelete: Cascade)

  addresseeId String
  addressee   User   @relation("FriendshipAddressee",fields: [addresseeId],references: [id],onDelete: Cascade)

  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

//
// JEUX
//

model Game {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  coverUrl    String?
  launchUrl   String?

  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Parties
  invites  GameInvite[]

  // Leaderboard
  leaderboards Leaderboard[]

  // Succès
  achievements Achievement[]

  @@index([isActive])
}

//
// PARTIES
//

enum PlayerStatus {
  INVITED
  JOINED
  PLAYING
  FINISHED
  LEFT
  DECLINED
}

//
// INVITATIONS À UNE PARTIE
//

model GameInvite {
  id String @id @default(uuid())

  senderId String
  sender   User   @relation("InviteSender",fields: [senderId],references: [id],onDelete: Cascade)

  receiverId String
  receiver   User   @relation("InviteReceiver",fields: [receiverId],references: [id],onDelete: Cascade)

  gameId String
  game   Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  status      InviteStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  respondedAt DateTime?

  @@index([receiverId, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

//
// LEADERBOARD
//

model Leaderboard {
  id String @id @default(uuid())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  name      String
  period    LeaderboardPeriod @default(ALL_TIME)
  sortOrder SortOrder         @default(DESC)

  scores LeaderboardScore[]

  @@unique([gameId, period])
  @@index([gameId])
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum SortOrder {
  ASC
  DESC
}

model LeaderboardScore {
  id String @id @default(uuid())

  leaderboardId String
  leaderboard   Leaderboard @relation(fields: [leaderboardId],references: [id],onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId],references: [id],onDelete: Cascade)

  score      Float
  recordedAt DateTime @default(now())

  @@index([leaderboardId, score])
  @@index([userId])
}

//
// SUCCÈS
//

model Achievement {
  id String @id @default(uuid())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  name        String
  description String?
  iconUrl     String?
  points      Int     @default(10)
  isSecret    Boolean @default(false)

  users UserAchievement[]

  @@unique([gameId, name])
  @@index([gameId])
}

model UserAchievement {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId],references: [id],onDelete: Cascade)

  achievementId String
  achievement   Achievement @relation(fields: [achievementId],references: [id],onDelete: Cascade)

  unlockedAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([achievementId])
}